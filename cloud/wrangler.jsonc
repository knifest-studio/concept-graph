{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "concept-graph-cloud",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "triggers": { "crons": ["23 3 * * *"] },
  "vars": { "NANO_BANANA_DAILY_IMAGES": "50", "NANO_BANANA_MONTHLY_USD": "50", "FAL_UPSCALERS": "off" },
  "durable_objects": {
    "bindings": [
      { "name": "BoardRoom", "class_name": "BoardRoom" },
      { "name": "Directory", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom", "Directory"] }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "concept-graph-files" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "68a0d7c318044dffbd40a62d488593e9" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "concept-graph-cloud", "database_id": "cb8f2e9c-34aa-4861-883e-498832370baf" }
  ],
  "assets": {
    "directory": "../dist-cloud",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/concept-graph-helper-downloads.json", "/privacy", "/b/*", "/api/*", "/assets/*", "/downloads/*", "/parties/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"]
  }
}
